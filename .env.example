# ==============================================================================
# OPTION 1: SWU AI (มศว - Srinakharinwirot University Free AI Services)
# ==============================================================================
# ใส่ Token ที่ได้รับจากระบบสารสนเทศ มศว (https://swuai.swu.ac.th/)
SWU_API_KEY=your_swu_token_here
SWU_BASE_URL=https://swuai.swu.ac.th/swu/api/service
# โมเดลแนะนำสำหรับ SWU AI Gateway (เช่น anthropic/claude-sonnet-5.5):
ORCHESTRATOR_MODEL=anthropic/claude-sonnet-5.5
FRONTEND_MODEL=anthropic/claude-sonnet-5.5
BACKEND_MODEL=anthropic/claude-sonnet-5.5
QA_MODEL=anthropic/claude-sonnet-5.5

# ==============================================================================
# OPTION 2: Google Gemini (Free Tier from Google AI Studio - https://aistudio.google.com)
# ==============================================================================
# GEMINI_API_KEY=AIzaSy...
# ORCHESTRATOR_MODEL=gemini/gemini-2.5-flash
# FRONTEND_MODEL=gemini/gemini-2.5-flash
# BACKEND_MODEL=gemini/gemini-2.5-flash
# QA_MODEL=gemini/gemini-2.5-flash

# ==============================================================================
# OPTION 3: OpenRouter (Free or Paid models - https://openrouter.ai)
# ==============================================================================
# OPENROUTER_API_KEY=sk-or-v1-...
# ORCHESTRATOR_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
# FRONTEND_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
# BACKEND_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
# QA_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

# Maximum QA-Fix feedback loop iterations before halting
MAX_ROUNDS=3

