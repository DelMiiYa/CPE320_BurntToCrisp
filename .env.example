# Use Google Antigravity CLI (`agy`) and its saved Google account login by default.
# AGENT_BACKEND defaults to antigravity (no need to change unless selecting codex or legacy).
AGENT_BACKEND=antigravity
AGY_BIN=agy

# Empty model/effort fields use the Office task policy:
# Gemini 3.8 Flash Low for small plans/cosmetics/summaries; Medium for functional builds and test authoring.
# Available models are checked with: agy models
AGY_MODEL=
ORCHESTRATOR_AGY_MODEL=
FRONTEND_AGY_MODEL=
BACKEND_AGY_MODEL=
QA_AGY_MODEL=

# Optional explicit overrides. A Gemini tier suffix must match its effort (e.g. -medium / medium).
AGY_EFFORT=
ORCHESTRATOR_AGY_EFFORT=
FRONTEND_AGY_EFFORT=
BACKEND_AGY_EFFORT=
QA_AGY_EFFORT=
AGY_TIMEOUT_SECONDS=600
MAX_ROUNDS=3

# Optional: To use Codex CLI instead, set:
# AGENT_BACKEND=codex
# CODEX_BIN=codex
# CODEX_MODEL=
# ORCHESTRATOR_CODEX_MODEL=
# FRONTEND_CODEX_MODEL=
# BACKEND_CODEX_MODEL=
# QA_CODEX_MODEL=
# CODEX_TIMEOUT_SECONDS=600

# Legacy API integrations are opt-in with AGENT_BACKEND=legacy.
