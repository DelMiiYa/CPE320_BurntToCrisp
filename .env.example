# Use the installed Codex CLI and its saved login (`codex login`).
# SWU_API_KEY, GEMINI_API_KEY and OPENROUTER_API_KEY are not used in this mode.
AGENT_BACKEND=codex
CODEX_BIN=codex

# Leave empty for the Codex CLI default. Use native model IDs available to
# your account, without a provider/ prefix. Per-role values override CODEX_MODEL.
CODEX_MODEL=
ORCHESTRATOR_CODEX_MODEL=
FRONTEND_CODEX_MODEL=
BACKEND_CODEX_MODEL=
QA_CODEX_MODEL=

CODEX_TIMEOUT_SECONDS=600
MAX_ROUNDS=3

# Existing API integrations are opt-in with AGENT_BACKEND=legacy.
# Never copy credentials from Codex authentication files into this project.
