# Google Gemini API Key (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM model configuration per specialist (CrewAI / LiteLLM format: gemini/<model-name>)
# Pro-class models recommended for high reasoning (Orchestrator, QA)
# Flash-class models recommended for fast generation (Frontend, Backend)
ORCHESTRATOR_MODEL=gemini/gemini-3.8-flash
FRONTEND_MODEL=gemini/gemini-3.8-flash
BACKEND_MODEL=gemini/gemini-3.8-flash
QA_MODEL=gemini/gemini-3.8-flash

# Maximum QA-Fix feedback loop iterations before halting
MAX_ROUNDS=3
